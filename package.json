{
  "name": "pothos-drizzle-generator-sample",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:docker && pnpm run drizzle:reset && tsx --watch src/index.ts",
    "dev:docker": "docker compose -f docker/docker-compose.yml up -d",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:reset": "tsx tools/reset && pnpm run drizzle:migrate && pnpm run drizzle:seed",
    "drizzle:seed": "tsx tools/seed",
    "build": "tsc",
    "start": "node dist",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "graphql-schema": "tsx ./tools/exportSchema.ts"
  },
  "dependencies": {
    "@hono/graphql-server": "^0.7.0",
    "@hono/node-server": "^2.0.3",
    "@pothos/core": "^4.12.0",
    "@pothos/plugin-drizzle": "^0.17.4",
    "@types/graphql": "^14.5.0",
    "apollo-explorer": "^1.1.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.3",
    "graphql": "^16.14.0",
    "graphql-auto-query": "^1.1.1",
    "hono": "^4.12.22",
    "jose": "^6.2.3",
    "pothos-drizzle-generator": "^0.2.0",
    "sql-formatter": "15.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "drizzle-kit": "1.0.0-rc.3",
    "drizzle-seed": "1.0.0-rc.3",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  },
  "version": "1.0.0",
  "main": "index.js",
  "author": "SoraKumo <info@croud.jp>",
  "license": "MIT",
  "repository": "https://github.com/SoraKumo001/pothos-drizzle-generator-sample"
}
